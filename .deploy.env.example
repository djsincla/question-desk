# Copy to .deploy.env (git ignores it) and fill in for your install.
# Deployment ID: Apps Script editor → Deploy → Manage deployments → the web app's ID.
QD_DEPLOYMENT_ID=
# The clasp account that owns the project (clasp login --user <name>). Leave blank for clasp's default login.
QD_CLASP_USER=
# Optional: your Workspace domain, so the live check also tries the /a/<domain>/ address form.
QD_DOMAIN=
